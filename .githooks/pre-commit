#!/bin/sh
# Scan bus payloads only. Do not scan this hook or scripts/scan-secrets.sh.
# Both name the patterns they reject, and a self-scan cannot be committed.
files=$(git diff --cached --name-only -- bus)
if [ -z "$files" ]; then
  exit 0
fi
root=$(git rev-parse --show-toplevel)
for f in $files; do
  case "$f" in
    *.json)
      if git show ":$f" | grep -q "$(printf '\r')"; then
        echo "REJECT CR in $f" >&2
        exit 1
      fi
      ;;
  esac
done
# shellcheck disable=SC2086
"$root/scripts/scan-secrets.sh" --cached $files
exit $?
