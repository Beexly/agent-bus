#!/bin/sh
# Scan bus payloads only. Do not scan this file. It contains the patterns it rejects.
files=$(git diff --cached --name-only -- bus)
if [ -z "$files" ]; then
  exit 0
fi
if git diff --cached -U0 -- $files | grep -E 'sk_live_|sk_test_|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|xox[baprs]-|BEGIN PRIVATE KEY'; then
  echo "REJECT secret in bus file" >&2
  exit 1
fi
# A CR in status.json breaks the claim parser on Windows.
for f in $files; do
  case "$f" in
    *.json)
      if git show ":$f" | grep -q "$(printf '\r')"; then
        echo "REJECT CR in $f" >&2
        exit 1
      fi
      ;;
  esac
done
exit 0
