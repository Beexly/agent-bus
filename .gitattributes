# Line endings are a lock, not a hint.
# Windows core.autocrlf must also be false. This file still wins on checkout.

# Default. text=auto alone is not enough: Git skips eol conversion
# on anything it guesses is binary. Explicit rules below cover the bus.
* text=auto eol=lf

# Bus payloads. Never CRLF. A CR in status.json breaks the claim parser.
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf

bus/**             text eol=lf
agents/**          text eol=lf
scripts/**         text eol=lf
.githooks/**       text eol=lf
BEEX-AGENT-TEAM.md text eol=lf
AGENTS.md          text eol=lf
STATUS.md          text eol=lf linguist-generated=true

# Binary. Do not let text=auto touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary

# Never export local machine files.
.githooks/ export-ignore
*.local export-ignore
.env export-ignore
.env.* export-ignore
